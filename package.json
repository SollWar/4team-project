{
  "name": "4team-project",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "4team-site",
    "4team-server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SITE,SRVR\" -c \"bgBlue,bgGreen\" \"npm run dev -w 4team-site\" \"npm run dev -w 4team-server\"",
    "build": "npm run build -w 4team-site && npm run build -w 4team-server",
    "start": "concurrently -n \"SITE,SRVR\" -c \"bgBlue,bgGreen\" \"npm run start -w 4team-site\" \"npm run start -w 4team-server\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}
